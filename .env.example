# GEMINI_API_KEY: Required for Gemini AI API calls (Image & Text document extraction).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Connection for SRC_CCE Database
MONGODB_URI="mongodb://127.0.0.1:27017/?directConnection=true&serverSelectionTimeoutMS=2000&appName=mongosh+2.14.1"
MONGODB_DB="SRC_CCE"
